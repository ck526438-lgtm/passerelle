# ─── L'essentiel pour lancer la démo (aucun de ces champs n'est requis) ───
PORT=8787
# Jeton d'accès au tableau de bord /admin. Laisse vide => usage local uniquement.
ADMIN_TOKEN=
# "test" = pas besoin de WhatsApp, on injecte les messages depuis l'UI. "cloud" = API Meta.
WA_PROVIDER=test

# ─── WhatsApp Cloud API (officiel, recommandé pour la prod) ───
# Meta App > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=choisis-un-mot-de-passe-long
WA_API_VERSION=v23.0

# ─── Voix => texte (API compatible OpenAI Whisper) ───
# Marche aussi avec Groq (https://api.groq.com/openai/v1) : 10x moins cher.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=fr

# ─── Extraction intelligente (titre, échéance, catégorie) ───
LLM_MODEL=gpt-4o-mini

# ─── Notion ───
# integration notion.so/my-integrations, puis "Add connections" sur la base
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ─── Google Sheets ───
# Compte de service (JSON) : colle le contenu du fichier, ou mets le chemin
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=
SHEET_ID=

# ─── Airtable ───
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Contacts

# ─── Garde-fous ───
MAX_MEDIA_MB=16
COOLDOWN_SECONDS=90

# Heures d'ouverture du commerce (utilisées par la règle « hors heures »)
BUSINESS_HOURS=8-19
BUSINESS_DAYS=1-6
UTC_OFFSET_MINUTES=120

# Slack / Make / n8n : notifié par la règle « urgence »
ALERT_WEBHOOK_URL=
